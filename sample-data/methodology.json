{
  "_comment": "Fixed methodology definition — identical for every publisher, so it is served separately from per-publisher results rather than repeated in each payload. Also the home for each component's unit, which the results payload deliberately omits.",
  "bands": {
    "needs_improvement": 0,
    "good": 1,
    "very_good": 2,
    "excellent": 3
  },
  "dimensions": {
    "timeliness": {
      "_comment": "Banded on its weakest component, as the API bands it. The frequency component is rescored client-side from stats.frequency_old: frequency_new under-reports recent updates for publishers that in fact publish monthly."
    }
  },
  "components": {
    "downloadable": {
      "unit": "boolean",
      "thresholds": {
        "good": true,
        "very_good": true,
        "excellent": true
      }
    },
    "no_critical_errors": {
      "unit": "boolean",
      "thresholds": {
        "good": true,
        "very_good": true,
        "excellent": true
      }
    },
    "timeliness": {
      "unit": "enum",
      "thresholds": {
        "good": "one_quarter",
        "very_good": "one_month",
        "excellent": "one_month"
      }
    },
    "frequency": {
      "unit": "enum",
      "thresholds": {
        "good": "quarterly",
        "very_good": "monthly",
        "excellent": "monthly"
      }
    },
    "coverage": {
      "unit": "percent",
      "thresholds": {
        "good": 40,
        "very_good": 60,
        "excellent": 80
      }
    },
    "disaggregation": {
      "unit": "count",
      "thresholds": {
        "good": 2,
        "very_good": 3,
        "excellent": 4
      }
    },
    "organisation_fields": {
      "unit": "percent",
      "thresholds": {
        "good": 40,
        "very_good": 60,
        "excellent": 75
      }
    },
    "basic_fields": {
      "unit": "percent",
      "thresholds": {
        "good": 90,
        "very_good": 95,
        "excellent": 99
      }
    },
    "financial_fields": {
      "unit": "percent",
      "thresholds": {
        "good": 60,
        "very_good": 70,
        "excellent": 90
      }
    },
    "advanced_fields": {
      "_comment": "No 'good' threshold — the first star is not required for this component.",
      "unit": "percent",
      "thresholds": {
        "very_good": 60,
        "excellent": 80
      }
    }
  }
}
