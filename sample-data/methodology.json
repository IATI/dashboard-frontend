{
  "_comment": "Fixed methodology definition \u2014 identical for every publisher, so it is served separately from per-publisher results rather than repeated in each payload. Also the home for each component's unit, which the results payload deliberately omits.",
  "bands": {
    "needs_improvement": 0,
    "good": 1,
    "very_good": 2,
    "excellent": 3
  },
  "dimensions": {
    "timeliness": {
      "_comment": "Band is a joint function of both components, not an aggregate of their individual bands: both monthly/one month => excellent; both quarterly/one quarter, or either one monthly/one month => good; otherwise needs_improvement."
    }
  },
  "check_groups": {
    "_comment": "Maps each activity check to a comprehensiveness component, keyed on the check's group prefix (the part before the colon in gherkin_tests_current). Keying on the prefix rather than the full check name keeps this stable when individual checks are reworded, and covers all 44 current checks.",
    "Actual dates": "basic_fields",
    "Aid type": "basic_fields",
    "Budget": "financial_fields",
    "Budget Alignment": "advanced_fields",
    "Budget document": "advanced_fields",
    "Commitment": "financial_fields",
    "Conditions": "advanced_fields",
    "Contact details": "advanced_fields",
    "Current status": "basic_fields",
    "Description": "basic_fields",
    "Disbursements and expenditures": "financial_fields",
    "Finance type": "basic_fields",
    "Flow type": "basic_fields",
    "Impact appraisal": "advanced_fields",
    "Location": "advanced_fields",
    "Location (with activity-scope exclusion)": "advanced_fields",
    "Networked Data - Implementors": "advanced_fields",
    "Objectives": "basic_fields",
    "Planned dates": "basic_fields",
    "Procurement": "advanced_fields",
    "Results": "advanced_fields",
    "Reviews and evaluations": "advanced_fields",
    "Sector": "basic_fields",
    "Tied aid status": "basic_fields",
    "Title": "basic_fields",
    "Unique ID": "basic_fields"
  },
  "components": {
    "downloadable": {
      "unit": "boolean",
      "thresholds": {
        "good": true,
        "very_good": true,
        "excellent": true
      }
    },
    "no_critical_errors": {
      "unit": "boolean",
      "thresholds": {
        "good": true,
        "very_good": true,
        "excellent": true
      }
    },
    "no_errors": {
      "unit": "boolean",
      "thresholds": {
        "good": true,
        "very_good": true,
        "excellent": true
      }
    },
    "timeliness": {
      "unit": "enum",
      "thresholds": {
        "good": "one_quarter",
        "very_good": "one_month",
        "excellent": "one_month"
      }
    },
    "frequency": {
      "unit": "enum",
      "thresholds": {
        "good": "quarterly",
        "very_good": "monthly",
        "excellent": "monthly"
      }
    },
    "coverage": {
      "unit": "percent",
      "thresholds": {
        "good": 40,
        "very_good": 60,
        "excellent": 80
      }
    },
    "disaggregation": {
      "unit": "count",
      "thresholds": {
        "good": 2,
        "very_good": 3,
        "excellent": 4
      }
    },
    "organisation_fields": {
      "unit": "percent",
      "thresholds": {
        "good": 40,
        "very_good": 60,
        "excellent": 75
      }
    },
    "basic_fields": {
      "unit": "percent",
      "thresholds": {
        "good": 90,
        "very_good": 95,
        "excellent": 99
      }
    },
    "financial_fields": {
      "unit": "percent",
      "thresholds": {
        "good": 60,
        "very_good": 70,
        "excellent": 90
      }
    },
    "advanced_fields": {
      "_comment": "No 'good' threshold \u2014 the first star is not required for this component.",
      "unit": "percent",
      "thresholds": {
        "very_good": 60,
        "excellent": 80
      }
    }
  }
}
